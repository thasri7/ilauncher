<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CustomKeyboard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:statusBarColor">@color/kb_bg</item>
        <item name="android:windowBackground">@color/kb_bg</item>
    </style>

    <style name="Theme.SquareLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/metro_blue</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
