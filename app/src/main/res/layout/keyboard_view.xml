<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/keyboard_outer_frame"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg">

    <LinearLayout
        android:id="@+id/keyboard_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kb_bg"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <!-- Collapsed toolbar: a slim handle to bring it back. -->
        <LinearLayout
            android:id="@+id/fold_bar"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@color/kb_bg"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_unfold"
                android:layout_width="48dp"
                android:layout_height="22dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Show toolbar"
                android:padding="2dp"
                android:src="@drawable/ic_kb_expand"
                android:tint="@color/kb_text_secondary" />
        </LinearLayout>

        <!-- Toolbar: line icons, most used first; scrolls sideways for the rest. -->
        <HorizontalScrollView
            android:id="@+id/top_toolbar_scroll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/toolbar_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/action_fold"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Hide toolbar"
                    android:src="@drawable/ic_kb_collapse" />

                <ImageView
                    android:id="@+id/action_clips"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Clipboard"
                    android:src="@drawable/ic_kb_clipboard" />

                <ImageView
                    android:id="@+id/action_quick"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Quick replies"
                    android:src="@drawable/ic_kb_chat" />

                <ImageView
                    android:id="@+id/action_translate"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Translate"
                    android:src="@drawable/ic_kb_translate" />

                <ImageView
                    android:id="@+id/action_focus"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Cursor and selection"
                    android:src="@drawable/ic_kb_cursor" />

                <ImageView
                    android:id="@+id/action_fancy"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Fancy text"
                    android:src="@drawable/ic_kb_fonts" />

                <ImageView
                    android:id="@+id/action_voice"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Voice typing"
                    android:src="@drawable/ic_kb_mic" />

                <ImageView
                    android:id="@+id/action_one_hand"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="One-handed mode"
                    android:src="@drawable/ic_kb_onehand" />

                <ImageView
                    android:id="@+id/action_undo"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Undo delete"
                    android:src="@drawable/ic_kb_undo" />

                <ImageView
                    android:id="@+id/action_apps"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Open an app"
                    android:src="@drawable/ic_m_apps" />

                <ImageView
                    android:id="@+id/action_settings"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Keyboard settings"
                    android:src="@drawable/ic_m_settings" />

                <ImageView
                    android:id="@+id/action_switch_ime"
                    style="@style/KbToolbarIcon"
                    android:contentDescription="Switch keyboard"
                    android:src="@drawable/ic_m_keyboard" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Unified Smart Suggestion & Action Strip -->
        <FrameLayout
            android:id="@+id/smart_strip_frame"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="3dp"
            android:background="@color/kb_toolbar_bg">

            <!-- View 1: Active 3-Candidate Suggestions Bar (Typing) -->
            <LinearLayout
                android:id="@+id/suggestion_typing_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/suggestion_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/kb_text_secondary"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <View
                    android:id="@+id/divider_suggestion_1"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/kb_key_border" />

                <TextView
                    android:id="@+id/suggestion_center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <View
                    android:id="@+id/divider_suggestion_2"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/kb_key_border" />

                <TextView
                    android:id="@+id/suggestion_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/kb_text_secondary"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- View 2: Smart Idle Bar (When NOT typing - NEVER BLANK!) -->
            <HorizontalScrollView
                android:id="@+id/smart_idle_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:id="@+id/smart_idle_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- View 3: In-Bar Feature Drawer (Quick replies / Clips / Translate / Fonts) -->
            <HorizontalScrollView
                android:id="@+id/feature_drawer_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:visibility="gone"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:id="@+id/feature_drawer_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </FrameLayout>

        <!-- Main Keyboard Keys Wrapper -->
        <LinearLayout
            android:id="@+id/keyboard_keys_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 0: Dedicated Numbers Row -->
            <LinearLayout
                android:id="@+id/row_numbers"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp" />

            <!-- Row 1: Letters (QWERTY) -->
            <LinearLayout
                android:id="@+id/row_1"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp" />

            <!-- Row 2: Letters (ASDF...) -->
            <LinearLayout
                android:id="@+id/row_2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp" />

            <!-- Row 3: Shift + ZXCVB... + Backspace -->
            <LinearLayout
                android:id="@+id/row_3"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp" />

            <!-- Row 4: Symbols toggle + Comma + Space + Period + Enter -->
            <LinearLayout
                android:id="@+id/row_4"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal" />

        </LinearLayout>

    </LinearLayout>

    <!-- Floating Key Popup Preview (Positions directly above pressed key) -->
    <TextView
        android:id="@+id/key_popup_preview"
        android:layout_width="56dp"
        android:layout_height="62dp"
        android:visibility="gone"
        android:background="@drawable/bg_key_popup"
        android:gravity="center"
        android:textColor="@color/kb_accent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:elevation="16dp" />

</FrameLayout>
