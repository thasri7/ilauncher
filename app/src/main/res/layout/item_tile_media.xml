<?xml version="1.0" encoding="utf-8"?>
<!-- Music tile: album art fills the tile behind the track info and transport controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_media_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/v_media_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tile_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/face_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_media_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_m_music" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_media_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/ll_media_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_media_prev"
                style="@style/MetroMediaButton"
                android:contentDescription="Previous"
                android:src="@drawable/ic_m_prev" />

            <ImageView
                android:id="@+id/btn_media_play_pause"
                style="@style/MetroMediaButton"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Play or pause"
                android:src="@drawable/ic_m_play" />

            <ImageView
                android:id="@+id/btn_media_next"
                style="@style/MetroMediaButton"
                android:contentDescription="Next"
                android:src="@drawable/ic_m_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
