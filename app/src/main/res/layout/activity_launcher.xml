<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A60A0D14"
    android:fitsSystemWindows="true">

    <!-- Top Status & Navigation Bar -->
    <LinearLayout
        android:id="@+id/ll_top_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_metro_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Tiles"
            android:textColor="@color/metro_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Add Tile Button (+) -->
        <FrameLayout
            android:id="@+id/btn_add_tile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_metro_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="➕"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- Express Inbuilt Keyboard Search Button -->
        <FrameLayout
            android:id="@+id/btn_open_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_metro_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔍"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Switch between Tiles and All Apps -->
        <FrameLayout
            android:id="@+id/btn_toggle_page"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_metro_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_btn_toggle_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="➔"
                android:textColor="@color/metro_cyan"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Settings Button -->
        <FrameLayout
            android:id="@+id/btn_open_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_metro_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚙️"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main Content: ViewPager2 with 3D Cube Rotation (Tiles on a Cube) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_launcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_top_nav"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Integrated Inbuilt Custom Keyboard Search Overlay -->
    <LinearLayout
        android:id="@+id/panel_inbuilt_keyboard_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA0B0E14"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Search Bar Top Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <EditText
                android:id="@+id/et_express_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metro_search"
                android:hint="Type app name or 45*12..."
                android:imeOptions="actionSearch"
                android:inputType="textNoSuggestions"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/metro_text_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_metro_tile"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btn_close_keyboard_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_metro_tile"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/metro_cyan"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Live Math Calculator or Web Search Shortcut Result Strip -->
        <LinearLayout
            android:id="@+id/ll_search_action_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_math_calc_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_metro_tile"
                android:backgroundTint="@color/metro_green"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="= 0"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_web_search_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_metro_tile"
                android:backgroundTint="@color/metro_blue"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="🌐 Search Google"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Real-time Filtered Search Results -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="10dp" />

        <!-- Inbuilt Custom Keyboard Board Container -->
        <include
            android:id="@+id/inbuilt_custom_keyboard_view"
            layout="@layout/layout_launcher_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</RelativeLayout>
