<?xml version="1.0" encoding="utf-8"?>
<!-- Photos tile: full-bleed slideshow of picked photos; each live beat slides in the next one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/face_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/face_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tv_photos_label"
        style="@style/MetroTileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tile_scrim"
        android:paddingStart="7dp"
        android:paddingTop="16dp"
        android:paddingEnd="7dp"
        android:paddingBottom="7dp" />

    <LinearLayout
        android:id="@+id/ll_photos_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_m_photo" />

        <TextView
            style="@style/MetroTileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tap to choose photos" />
    </LinearLayout>
</FrameLayout>
