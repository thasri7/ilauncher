<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:padding="3dp">

    <RelativeLayout
        android:id="@+id/tile_contact_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_metro_tile"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="📞"
            android:textSize="14sp" />

        <!-- Avatar Initial / Picture -->
        <TextView
            android:id="@+id/tv_contact_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_metro_badge"
            android:backgroundTint="@color/metro_blue"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Contact"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="normal" />
    </RelativeLayout>
</FrameLayout>
