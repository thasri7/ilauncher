<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kb_key_pressed">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/kb_key_top"
                android:endColor="@color/kb_key_bottom" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/kb_key_border" />
        </shape>
    </item>
</ripple>
