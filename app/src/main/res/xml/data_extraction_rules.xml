<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <!-- Keyboard clipboard history can hold private text: it stays on this phone. -->
        <exclude domain="sharedpref" path="ikeys_prefs.xml" />
        <include domain="file" path="tile_media" />
        <include domain="file" path="start_background.jpg" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <!-- Keyboard clipboard history can hold private text: it stays on this phone. -->
        <exclude domain="sharedpref" path="ikeys_prefs.xml" />
        <include domain="file" path="tile_media" />
        <include domain="file" path="start_background.jpg" />
    </device-transfer>
</data-extraction-rules>
